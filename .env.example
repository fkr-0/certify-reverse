# Global runtime settings for certify-reverse
DNS_PROVIDER=desec
DNS_TOKEN=REPLACE_WITH_DNS_API_TOKEN
# Credential field expected by the selected Caddy DNS plugin (commonly api_token or token)
CADDY_DNS_PLUGIN_TOKEN_FIELD=api_token
ACME_EMAIL=admin@example.com
DOMAIN=example.com
# Wildcard DNS answer IP for *.DOMAIN (should point to your Caddy entrypoint IP)
# DNSMASQ_ADDRESS_MODE:
# - manual: use DNSMASQ_ADDRESS_IP
# - host-src-ip: derive host src IP from `ip -4 route get 1.1.1.1` with fallback to DNSMASQ_ADDRESS_IP
DNSMASQ_ADDRESS_MODE=manual
DNSMASQ_ADDRESS_IP=10.0.0.1
# Optional. Use latest by default, or pin (e.g., v2.10.2)
CADDY_VERSION=latest
# Optional docker build base image used for caddy builder stage
CADDY_BUILDER_IMAGE=caddy:2.10.0-builder
# Optional extra dnsmasq CLI flags, e.g. "-q --log-facility=-"
DNSMASQ_EXTRA_ARGS=
