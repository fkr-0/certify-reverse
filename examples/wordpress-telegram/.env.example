WORDPRESS_DB_NAME=wordpress
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=replace-with-a-long-random-password
WORDPRESS_DB_ROOT_PASSWORD=replace-with-another-long-random-password

# Optional. Needed only when registering the real Telegram webhook.
TELEGRAM_BOT_TOKEN=replace-with-botfather-token

# Telegram sends this value in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-secret
